{
  "name": "packeta-pricelist",
  "version": "0.1.0",
  "description": "Unofficial: turns the public Packeta (SK) and Zásilkovna (CZ) price list PDFs into validated JSON, with a shipping quote calculator.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./schema": "./schema/pricelist.schema.json"
  },
  "bin": {
    "packeta-pricelist": "./bin/cli.js"
  },
  "files": ["src", "bin", "schema", "README.md", "DISCLAIMER.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "parse": "node bin/cli.js parse",
    "dump": "node scripts/dump-lines.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pdfjs-dist": "^6.3.289"
  }
}
